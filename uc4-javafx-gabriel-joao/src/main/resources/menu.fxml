<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12.0" prefWidth="220.0" prefHeight="200.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.uc4javafxgabrieljoao.controller.MenuController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <Button mnemonicParsing="false" onAction="#exibirCadastro" prefHeight="40.0" prefWidth="190.0" text="Cadastrar Sessão" />
      <Button mnemonicParsing="false" onAction="#exibirLista" prefHeight="40.0" prefWidth="190.0" text="Listar Sessões" />
      <Button mnemonicParsing="false" onAction="#sair" prefHeight="40.0" prefWidth="190.0" text="Sair" />
   </children>
</VBox>

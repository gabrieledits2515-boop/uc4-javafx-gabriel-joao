<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="app.uc4javafxgabrieljoao.controller.CatalogoController">
    <top>
        <VBox spacing="14" styleClass="topo">
            <padding><Insets top="16" right="28" bottom="16" left="28"/></padding>
            <HBox alignment="CENTER_LEFT">
                <Label text="📽 Catálogo de filmes" styleClass="logo"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="← Voltar" styleClass="secundario" onAction="#onVoltar"/>
            </HBox>
            <HBox spacing="12">
                <TextField fx:id="busca" promptText="🔎  Buscar por título..." prefWidth="320"/>
                <ComboBox fx:id="filtroGenero" prefWidth="190"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" styleClass="rolagem">
            <VBox fx:id="lista" spacing="16">
                <padding><Insets top="24" right="28" bottom="28" left="28"/></padding>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

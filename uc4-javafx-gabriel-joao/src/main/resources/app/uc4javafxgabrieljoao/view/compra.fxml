<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="app.uc4javafxgabrieljoao.controller.CompraController">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="topo">
            <padding><Insets top="16" right="28" bottom="16" left="28"/></padding>
            <Label text="🎟 Compra de ingresso" styleClass="logo"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" styleClass="rolagem">
            <HBox spacing="28">
                <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

                <VBox spacing="10" prefWidth="260" minWidth="260" maxWidth="260">
                    <StackPane fx:id="areaCartaz"/>
                    <Label fx:id="titulo" styleClass="titulo-grande" wrapText="true" maxWidth="260"/>
                    <Label fx:id="info" styleClass="sub"/>
                    <Label fx:id="sinopse" styleClass="sub" wrapText="true" maxWidth="260"/>
                </VBox>

                <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="painel">
                    <Label text="Sessão" styleClass="campo"/>
                    <ComboBox fx:id="sessao" prefWidth="300" promptText="Escolha a sessão"/>

                    <Label text="Quantidade de ingressos" styleClass="campo"/>
                    <Spinner fx:id="quantidade" prefWidth="120"/>

                    <Label text="Tipo de ingresso" styleClass="campo"/>
                    <ComboBox fx:id="tipo" prefWidth="300"/>

                    <Button text="💺 Escolher assentos" onAction="#onEscolherAssentos"/>

                    <Label text="Resumo da compra" styleClass="secao"/>
                    <Label fx:id="resumo" styleClass="resumo" wrapText="true"/>
                </VBox>
            </HBox>
        </ScrollPane>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="topo">
            <padding><Insets top="14" right="28" bottom="14" left="28"/></padding>
            <Button text="← Voltar" styleClass="secundario" onAction="#onVoltar"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnConfirmar" text="Confirmar compra" onAction="#onConfirmar"/>
        </HBox>
    </bottom>
</BorderPane>

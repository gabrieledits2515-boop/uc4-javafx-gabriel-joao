<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="app.uc4javafxgabrieljoao.controller.MenuController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="topo">
            <padding><Insets top="16" right="28" bottom="16" left="28"/></padding>
            <Label text="🎬 CINEMA" styleClass="logo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Catálogo de filmes" styleClass="secundario" onAction="#onCatalogo"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" styleClass="rolagem">
            <VBox spacing="18">
                <padding><Insets top="26" right="28" bottom="28" left="28"/></padding>
                <Label text="Em cartaz" styleClass="secao"/>
                <FlowPane fx:id="grade" hgap="22" vgap="22"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
